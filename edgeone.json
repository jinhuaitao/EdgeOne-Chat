{
  "name": "edgeone-chat",
  "installCommand": "npm install",
  "nodeVersion": "20.18.0",
  "cloudFunctions": {
    "maxDuration": 120
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
